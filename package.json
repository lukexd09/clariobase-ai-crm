{
  "name": "clariobase-ai-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "tsx --test tests/smoke.test.ts tests/docs-sanity.test.ts tests/homepage.test.ts tests/navigation.test.ts tests/work-view.test.ts tests/activity.test.ts tests/lead-drafts.test.ts tests/offer-drafts.test.ts tests/sales-report.test.ts",
    "prisma:generate": "node --env-file=.env.example ./node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file=.env.example ./node_modules/prisma/build/index.js validate",
    "prisma:migrate": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate dev",
    "prisma:seed": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "leads:import": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/import-leads.ts",
    "leads:detect-duplicates": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/detect-duplicates.ts",
    "ai:export-leads": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/export-ai-leads.ts",
    "ai:validate-import-file": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/validate-ai-import-file.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.4",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
