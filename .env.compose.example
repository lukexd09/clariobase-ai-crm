CRM_BIND_ADDRESS=127.0.0.1
CRM_HOST_PORT=3000
AI_EXCHANGE_HOST_PATH=./data/ai-exchange
CRM_POSTGRES_DB=clariobase_crm
CRM_POSTGRES_USER=clariobase_crm_user
# Required: copy this file to a local env file and set a real local-only password before first run.
CRM_POSTGRES_PASSWORD=
# Optional override when credentials need URI encoding in DATABASE_URL.
# Example: postgresql://clariobase_crm_user:your-percent-encoded-password@crm-postgres:5432/clariobase_crm?schema=public
CRM_DATABASE_URL=
CRM_DEPLOYMENT_ENV=production
