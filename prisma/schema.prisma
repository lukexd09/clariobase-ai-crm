generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  QUALIFIED
  TO_AUDIT
  AUDITED
  CONTACTED
  REPLIED
  DISCOVERY_SCHEDULED
  OFFER_SENT
  WON
  LOST
  NURTURE
  BAD_FIT
  DO_NOT_CONTACT
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PackageFit {
  UNKNOWN
  BASE
  CLARITY
  MOMENTUM
  NOT_FIT
}

enum ImportBatchStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ImportRowStatus {
  CREATED
  UPDATED
  REJECTED
  SKIPPED
}

enum ImportSourceType {
  LOCAL_JSON
  HARVESTER_EXPORT
  MANUAL_AI_PREPARED_FILE
}

enum DuplicateCandidateStatus {
  OPEN
  NEEDS_REVIEW
  DISMISSED
  RESOLVED
}

model Lead {
  id             String       @id @default(cuid())
  customerId     String       @unique @map("customer_id")
  businessName   String       @map("business_name")
  category       String?
  city           String?
  region         String?
  country        String?
  source         String?
  sourceRecordId String?      @map("source_record_id")
  googlePlaceId  String?      @unique @map("google_place_id")
  websiteUrl     String?      @map("website_url")
  instagramUrl   String?      @map("instagram_url")
  facebookUrl    String?      @map("facebook_url")
  phone          String?
  email          String?
  address        String?
  leadStatus     LeadStatus   @default(NEW) @map("lead_status")
  priority       LeadPriority @default(MEDIUM)
  packageFit     PackageFit   @default(UNKNOWN) @map("package_fit")
  scoreTotal     Int          @default(0) @map("score_total")
  scoreLabel     String?      @map("score_label")
  nextActionAt   DateTime?    @map("next_action_at")
  lastReviewedAt DateTime?    @map("last_reviewed_at")
  lastImportedAt  DateTime?    @map("last_imported_at")
  archivedAt     DateTime?    @map("archived_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  importRowResults ImportRowResult[]
  duplicateCandidatesAsLeadA DuplicateCandidate[] @relation("DuplicateCandidateLeadA")
  duplicateCandidatesAsLeadB DuplicateCandidate[] @relation("DuplicateCandidateLeadB")

  @@index([businessName])
  @@index([city, country])
  @@index([leadStatus, priority])
  @@unique([source, sourceRecordId])
  @@map("leads")
}

model ImportBatch {
  id            String             @id @default(cuid())
  sourceType    ImportSourceType   @map("source_type")
  sourceName    String?            @map("source_name")
  fileName      String?            @map("file_name")
  status        ImportBatchStatus
  totalRows     Int                @default(0) @map("total_rows")
  createdRows   Int                @default(0) @map("created_rows")
  updatedRows   Int                @default(0) @map("updated_rows")
  rejectedRows  Int                @default(0) @map("rejected_rows")
  skippedRows   Int                @default(0) @map("skipped_rows")
  startedAt     DateTime           @map("started_at")
  finishedAt    DateTime?          @map("finished_at")
  notes         String?
  errorSummary  String?            @map("error_summary")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  rows ImportRowResult[]

  @@index([sourceType, startedAt])
  @@index([status, startedAt])
  @@map("import_batches")
}

model ImportRowResult {
  id              String          @id @default(cuid())
  importBatchId    String          @map("import_batch_id")
  rowNumber        Int             @map("row_number")
  status          ImportRowStatus
  leadId          String?         @map("lead_id")
  customerId      String?         @map("customer_id")
  source          String?
  sourceRecordId  String?         @map("source_record_id")
  businessName    String?         @map("business_name")
  rejectionReason String?         @map("rejection_reason")
  rawRowSnapshot  Json?           @map("raw_row_snapshot")
  createdAt       DateTime        @default(now()) @map("created_at")

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  lead  Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([importBatchId, rowNumber])
  @@index([leadId])
  @@index([customerId])
  @@map("import_row_results")
}

model DuplicateCandidate {
  id           String                  @id @default(cuid())
  leadIdA      String                  @map("lead_id_a")
  leadIdB      String                  @map("lead_id_b")
  status       DuplicateCandidateStatus @default(OPEN)
  score        Int                     @default(0)
  reasons      Json
  reviewedAt   DateTime?               @map("reviewed_at")
  decisionNote String?                 @map("decision_note")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  leadA Lead @relation("DuplicateCandidateLeadA", fields: [leadIdA], references: [id], onDelete: Cascade)
  leadB Lead @relation("DuplicateCandidateLeadB", fields: [leadIdB], references: [id], onDelete: Cascade)

  @@unique([leadIdA, leadIdB])
  @@index([status, score])
  @@index([leadIdA])
  @@index([leadIdB])
  @@map("duplicate_candidates")
}
